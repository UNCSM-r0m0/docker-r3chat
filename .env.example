# =============================================================================
# R3CHAT - Variables de Entorno
# =============================================================================
# Copiar a .env y configurar valores según ambiente
# =============================================================================

# ==========================================
# ENTORNO
# ==========================================
# development: Desarrollo local (sin túneles)
# production:  Producción (con túneles)
NODE_ENV=development

# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_password
POSTGRES_DB=saas_db
DATABASE_URL=postgresql://postgres:local_password@postgres:5432/saas_db?schema=public

# ==========================================
# URLs (DESARROLLO LOCAL)
# ==========================================
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# CORS: Permitir todos los orígenes en desarrollo
# En producción, establecer en "false"
CORS_ALLOW_ALL=true

# ==========================================
# URLs (PRODUCCIÓN - Descomentar para prod)
# ==========================================
# NODE_ENV=production
# PORT=3000
# PUBLIC_URL=https://api.yourdomain.com
# FRONTEND_URL=https://app.yourdomain.com
# FRONTEND_URLS=https://app.yourdomain.com
# CORS_ALLOW_ALL=false

# ==========================================
# CLOUDFLARE TUNNEL (Solo Producción)
# ==========================================
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ==========================================
# CLOUDFLARE IMAGES (Opcional - para upload de imágenes)
# ==========================================
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_IMAGES_ACCOUNT_HASH=your_images_account_hash

# Las imágenes se servirán desde:
# https://imagedelivery.net/<CF_IMAGES_ACCOUNT_HASH>/<IMAGE_ID>/<VARIANT>
# Variantes: public, thumbnail, medium, large

  # ==========================================
  # NATS
  # ==========================================
  NATS_URL=nats://nats:4222

  # ==========================================
  # JWT
  # ==========================================
  JWT_SECRET=your_jwt_secret_here_min_32_chars
  JWT_EXPIRATION=7d
  JWT_ACCESS_EXPIRES=15m
  JWT_REFRESH_EXPIRES=30d

  # ==========================================
  # OAUTH (Google)
  # ==========================================
  GOOGLE_CLIENT_ID=your_google_client_id
  GOOGLE_CLIENT_SECRET=your_google_client_secret
  GOOGLE_CALLBACK_URL=${PUBLIC_URL}/api/auth/google/callback

  # ==========================================
  # OAUTH (GitHub)
  # ==========================================
  GITHUB_CLIENT_ID=your_github_client_id
  GITHUB_CLIENT_SECRET=your_github_client_secret
  GITHUB_CALLBACK_URL=${PUBLIC_URL}/api/auth/github/callback

  # ==========================================
  # ADMIN
  # ==========================================
  ADMIN_EMAIL=admin@yourdomain.com
  ADMIN_PASSWORD=your_secure_admin_password

  # ==========================================
  # LÍMITES DE USUARIOS
  # ==========================================
  FREE_USER_MESSAGE_LIMIT=3
  REGISTERED_USER_MESSAGE_LIMIT=5
  PREMIUM_USER_MESSAGE_LIMIT=50
  FREE_USER_MAX_TOKENS=512
  REGISTERED_USER_MAX_TOKENS=2048
  PREMIUM_USER_MAX_TOKENS=8192

  # ==========================================
  # STRIPE (Opcional)
  # ==========================================
  STRIPE_SECRET_KEY=sk_test_your_key
  STRIPE_WEBHOOK_SECRET=whsec_your_secret
  STRIPE_PREMIUM_PRICE_ID=price_your_price_id

  # ==========================================
  # FILE UPLOAD
  # ==========================================
  MAX_FILE_SIZE_MB=10
  ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

  # ==========================================
  # OLLAMA PROXY (Modelos Cloud)
  # ==========================================
  # El proxy corre como servicio en este compose
  OLLAMA_URL=http://ollama-proxy:8080
  OLLAMA_PROXY_URL=http://ollama-proxy:8080
  OLLAMA_PROXY_API_KEY=your_proxy_api_key_here

  # Modelos disponibles
  OLLAMA_MODEL=kimi-k2:1t-cloud
  PUBLIC_MODELS=kimi-k2:1t-cloud
  PRO_MODELS=kimi-k2.5:cloud,qwen3-vl:8b,deepseek-v3.1:671b-cloud
  OLLAMA_FALLBACK_MODEL=gpt-oss:20b-cloud

  # ==========================================
  # LLM STUDIO (Local AI - Opcional)
  # ==========================================
  # URL base de LM Studio (ej: http://localhost:1234)
  LLM_STUDIO_BASE_URL=
  LLM_STUDIO_MODEL=openai/gpt-oss-20b

  # ==========================================
  # CHAT STREAMING
  # ==========================================
  CHAT_STREAM_BATCH_MS=120
  CHAT_STREAM_BATCH_TARGET_CHARS=220
  CHAT_STREAM_BATCH_MIN_CHARS=32

