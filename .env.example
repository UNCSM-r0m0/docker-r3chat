# =============================================================================
  # R3CHAT - Variables de Entorno
  # =============================================================================

  # ==========================================
  # CLOUDFLARE TUNNEL
  # ==========================================
  TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

  # ==========================================
  # BASE DE DATOS
  # ==========================================
  POSTGRES_USER=postgres
  POSTGRES_PASSWORD=your_secure_password_here
  POSTGRES_DB=saas_db
  DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/saas_db?schema=public

  # ==========================================
  # ENTORNO Y URLs
  # ==========================================
  NODE_ENV=production
  PORT=3000
  PUBLIC_URL=https://api.yourdomain.com
  FRONTEND_URL=https://app.yourdomain.com
  FRONTEND_URLS=https://app.yourdomain.com

  # ==========================================
  # NATS
  # ==========================================
  NATS_URL=nats://nats:4222

  # ==========================================
  # JWT
  # ==========================================
  JWT_SECRET=your_jwt_secret_here_min_32_chars
  JWT_EXPIRATION=7d
  JWT_ACCESS_EXPIRES=15m
  JWT_REFRESH_EXPIRES=30d

  # ==========================================
  # OAUTH (Google)
  # ==========================================
  GOOGLE_CLIENT_ID=your_google_client_id
  GOOGLE_CLIENT_SECRET=your_google_client_secret
  GOOGLE_CALLBACK_URL=${PUBLIC_URL}/api/auth/google/callback

  # ==========================================
  # OAUTH (GitHub)
  # ==========================================
  GITHUB_CLIENT_ID=your_github_client_id
  GITHUB_CLIENT_SECRET=your_github_client_secret
  GITHUB_CALLBACK_URL=${PUBLIC_URL}/api/auth/github/callback

  # ==========================================
  # ADMIN
  # ==========================================
  ADMIN_EMAIL=admin@yourdomain.com
  ADMIN_PASSWORD=your_secure_admin_password

  # ==========================================
  # LÍMITES DE USUARIOS
  # ==========================================
  FREE_USER_MESSAGE_LIMIT=3
  REGISTERED_USER_MESSAGE_LIMIT=5
  PREMIUM_USER_MESSAGE_LIMIT=50
  FREE_USER_MAX_TOKENS=512
  REGISTERED_USER_MAX_TOKENS=2048
  PREMIUM_USER_MAX_TOKENS=8192

  # ==========================================
  # STRIPE (Opcional)
  # ==========================================
  STRIPE_SECRET_KEY=sk_test_your_key
  STRIPE_WEBHOOK_SECRET=whsec_your_secret
  STRIPE_PREMIUM_PRICE_ID=price_your_price_id

  # ==========================================
  # FILE UPLOAD
  # ==========================================
  MAX_FILE_SIZE_MB=10
  ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

  # ==========================================
  # OLLAMA PROXY (Modelos Cloud)
  # ==========================================
  # El proxy corre como servicio en este compose
  OLLAMA_URL=http://ollama-proxy:8080
  OLLAMA_PROXY_URL=http://ollama-proxy:8080
  OLLAMA_PROXY_API_KEY=your_proxy_api_key_here

  # Modelos disponibles
  OLLAMA_MODEL=kimi-k2:1t-cloud
  PUBLIC_MODELS=kimi-k2:1t-cloud
  PRO_MODELS=kimi-k2.5:cloud,qwen3-vl:8b,deepseek-v3.1:671b-cloud
  OLLAMA_FALLBACK_MODEL=gpt-oss:20b-cloud

  # ==========================================
  # CHAT STREAMING
  # ==========================================
  CHAT_STREAM_BATCH_MS=120
  CHAT_STREAM_BATCH_TARGET_CHARS=220
  CHAT_STREAM_BATCH_MIN_CHARS=32

  # ==========================================
  # API KEYS PARA MODELOS CLOUD (Opcional)
  # ==========================================
  GEMINI_API_KEY=
  OPENAI_API_KEY=
  DEEPSEEK_API_KEY=