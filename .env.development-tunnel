# =============================================================================
# R3CHAT - Desarrollo Local con Cloudflare Tunnel
# =============================================================================
# Copiar a .env y usar cuando trabajes con los dominios HTTPS locales
# =============================================================================

# ==========================================
# ENTORNO
# ==========================================
NODE_ENV=development

# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_password
POSTGRES_DB=saas_db
DATABASE_URL=postgresql://postgres:local_password@localhost:5433/saas_db?schema=public

# ==========================================
# URLs CON TÚNEL (HTTPS)
# ==========================================
PORT=3000
PUBLIC_URL=https://apitest.r0lm0.dev
FRONTEND_URL=https://testr3.r0lm0.dev
FRONTEND_URLS=https://testr3.r0lm0.dev,http://localhost:5173

# CORS: No usar allow_all en desarrollo con túnel
CORS_ALLOW_ALL=false

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# CACHE
# ==========================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600

# ==========================================
# RATE LIMITING
# ==========================================
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AI_TTL=60000
THROTTLE_AI_LIMIT=20
THROTTLE_UPLOAD_TTL=60000
THROTTLE_UPLOAD_LIMIT=10

# ==========================================
# NATS
# ==========================================
NATS_URL=nats://localhost:4222

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_jwt_secret_here_min_32_chars_for_dev
JWT_EXPIRATION=7d
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ==========================================
# OAUTH (Google) - Actualizar URLs en Cloud Console
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# IMPORTANTE: Debe coincidir con la URL configurada en Google Cloud Console
GOOGLE_CALLBACK_URL=https://apitest.r0lm0.dev/api/auth/google/callback

# ==========================================
# OAUTH (GitHub) - Actualizar URLs en GitHub App
# ==========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# IMPORTANTE: Debe coincidir con la URL configurada en GitHub App
GITHUB_CALLBACK_URL=https://apitest.r0lm0.dev/api/auth/github/callback

# ==========================================
# ADMIN
# ==========================================
ADMIN_EMAIL=admin@r0lm0.dev
ADMIN_PASSWORD=AdminDev123!

# ==========================================
# LÍMITES DE USUARIOS
# ==========================================
FREE_USER_MESSAGE_LIMIT=5
REGISTERED_USER_MESSAGE_LIMIT=10
PREMIUM_USER_MESSAGE_LIMIT=100
FREE_USER_MAX_TOKENS=512
REGISTERED_USER_MAX_TOKENS=2048
PREMIUM_USER_MAX_TOKENS=8192

# ==========================================
# STRIPE (Test Keys)
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PREMIUM_PRICE_ID=price_your_price_id

# ==========================================
# FILE UPLOAD
# ==========================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ==========================================
# CLOUDFLARE IMAGES (Opcional)
# ==========================================
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=

# ==========================================
# OLLAMA PROXY
# ==========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_PROXY_URL=http://localhost:8080
OLLAMA_PROXY_API_KEY=your_proxy_api_key
OLLAMA_MODEL=qwen2.5-coder:7b
PUBLIC_MODELS=qwen2.5-coder:7b
PRO_MODELS=kimi-k2.5:cloud,qwen3-vl:8b
OLLAMA_FALLBACK_MODEL=gpt-oss:20b-cloud

# ==========================================
# LLM STUDIO (Local AI)
# ==========================================
LLM_STUDIO_BASE_URL=
LLM_STUDIO_MODEL=openai/gpt-oss-20b

# ==========================================
# CHAT STREAMING
# ==========================================
CHAT_STREAM_BATCH_MS=120
CHAT_STREAM_BATCH_TARGET_CHARS=220
CHAT_STREAM_BATCH_MIN_CHARS=32
